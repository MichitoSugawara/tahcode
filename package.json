{
  "name": "dalecode",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 43173 --host 127.0.0.1",
    "dev:convex": "convex dev",
    "dev:files": "wrangler dev --config wrangler.jsonc --port 43174",
    "dev:all": "concurrently -k -n web,convex,files -c cyan,magenta,green \"npm run dev\" \"npm run dev:convex\" \"npm run dev:files\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 43173 --host 127.0.0.1",
    "preview:cf": "npm run build && wrangler dev --config wrangler.jsonc --port 43173",
    "deploy:cf": "npm run build && wrangler deploy",
    "lint": "eslint convex src runtime worker shared packages/cli/src --max-warnings=0",
    "typecheck": "tsc -b && tsc -p tsconfig.convex.json --noEmit && tsc -p tsconfig.runtime.json --noEmit",
    "test": "vitest run",
    "runtime": "tsx packages/cli/src/index.ts",
    "setup:local-auth": "node scripts/setup-local-auth.mjs",
    "cf:build": "node scripts/cf-build.mjs",
    "env:enc": "node scripts/env.mjs encrypt",
    "env:dec": "node scripts/env.mjs decrypt",
    "cli": "tsx packages/cli/src/index.ts",
    "cli:build": "node packages/cli/build.mjs"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.90",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.31.2",
    "convex-helpers": "^0.1.114",
    "jose": "^5.2.2",
    "lucide-react": "^0.562.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "remark-gfm": "^4.0.1",
    "shadow-plugin": "^2.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.25.2",
    "@convex-dev/eslint-plugin": "^1.1.1",
    "@dotenvx/dotenvx": "^2.24.1",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.3.0",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.54.0",
    "vite": "^8.3.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.57.0"
  }
}
