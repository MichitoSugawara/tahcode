# Copied to .env.local by `npx convex dev` (local deployment).
# Local development (anonymous agent mode, no Convex account needed):
#   CONVEX_AGENT_MODE=anonymous npx convex dev
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# Machine runtime (per registered runtime, shown once in the UI):
# CONVEX_URL=http://127.0.0.1:3210
# HARNESS_RUNTIME_ID=
# HARNESS_RUNTIME_TOKEN=th_...
