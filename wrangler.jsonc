{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "team-harness",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "team-harness-files"
    }
  ],
  "env": {
    "staging": {
      "name": "team-harness-staging",
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "team-harness-files-staging"
        }
      ]
    }
  }
}
